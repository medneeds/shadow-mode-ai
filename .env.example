# Modo Sombra — variáveis de ambiente (nunca commitar valores reais)

# Credencial do provedor de voz (server-only). Sem ela, o produto continua
# funcionando em modo texto; a voz é desativada de forma explícita.
ELEVENLABS_API_KEY=

# Overrides opcionais dos IDs de voz (domínio conhece apenas female/male).
ELEVENLABS_VOICE_ID_FEMALE=
ELEVENLABS_VOICE_ID_MALE=

# Overrides opcionais de modelo.
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5
